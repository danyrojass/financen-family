# Configuracion del proyecto Firebase (Firebase Console > Configuracion del proyecto > Tus apps).
# Estos valores son "publicos" por diseno (se incluyen en el bundle del navegador).
# La seguridad real vive en Firestore Rules + App Check, nunca en estas variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check (reCAPTCHA v3). Opcional en desarrollo; obligatorio en produccion si se habilita App Check.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Cloud Functions (requiere plan Blaze y `firebase deploy --only functions`).
# true: usa la Cloud Function `acceptInvitation` para aceptar invitaciones (recomendado).
# false: usa el flujo directo contra Firestore protegido por reglas.
VITE_USE_CLOUD_FUNCTIONS=false

# Region de las Cloud Functions desplegadas
VITE_FUNCTIONS_REGION=southamerica-east1

# Cotizacion por defecto sugerida al crear un hogar (el usuario la confirma/edita).
# No se usa para operaciones: cada movimiento guarda la cotizacion aplicada.
VITE_DEFAULT_USD_RATE=7500
